<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo delle schermate: bianco freddo con due aloni morbidi (caldo in basso a sinistra, azzurro in alto a destra),
     come lo sfondo dell'icona. In tema scuro diventa blu notte con gli stessi aloni, piu' tenui. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.95"
                android:centerY="0.0"
                android:gradientRadius="85%p"
                android:startColor="@color/glow_cool"
                android:endColor="@color/glow_clear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.0"
                android:centerY="1.0"
                android:gradientRadius="85%p"
                android:startColor="@color/glow_warm"
                android:endColor="@color/glow_clear" />
        </shape>
    </item>
</layer-list>
