<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ScreenAnnotator" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_orange</item>
        <item name="colorOnPrimary">@color/ink_on_orange</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        <item name="colorSecondary">@color/brand_blue</item>
        <item name="colorSecondaryContainer">@color/primary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_primary_container</item>
        <item name="colorTertiaryContainer">@color/primary_container</item>
        <item name="colorOnTertiaryContainer">@color/on_primary_container</item>
        <item name="colorTertiary">@color/brand_green</item>
        <item name="colorSurface">@color/bg</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/ink_muted</item>
        <item name="colorSurfaceVariant">@color/card_variant</item>
        <item name="colorSurfaceContainerLowest">@color/card</item>
        <item name="colorSurfaceContainerLow">@color/card</item>
        <item name="colorSurfaceContainer">@color/card</item>
        <item name="colorSurfaceContainerHigh">@color/card_variant</item>
        <item name="colorSurfaceContainerHighest">@color/card_variant</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/card_variant</item>
        <item name="android:colorBackground">@color/bg</item>
        <!-- stesso fondo con aloni delle schermate: niente lampo di colore all'apertura -->
        <item name="android:windowBackground">@drawable/bg_screen</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>
        <item name="android:windowLightNavigationBar">?attr/isLightTheme</item>
    </style>

    <!-- Activity trasparente che ospita solo un dialogo -->
    <style name="Theme.ScreenAnnotator.Dialog" parent="Theme.ScreenAnnotator">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
